{
	"Kestrel": {
		"Endpoints": {
			"Http": {
				"Url": "http://*:5101"
			}
		}
	},
	"Logging": {
		"LogLevel": {
			"Default": "Information",
			"Microsoft": "Warning",
			"Microsoft.EntityFrameworkCore": "Information",
			"System": "Warning"
		}
	},
	"AllowedHosts": "*",
	"ConnectionStrings": {
		"Default": "Server=localhost;Port=5440;Database=ryokouki;User ID=user;Password=test;"
	},
	"Application": {
		"CheckDbRetryCount": 10,
		"CheckDbRetryDelay": 60,
		"KnownProxies": [ "127.0.0.1" ],
		"AdminLogin": "admin",
		"AdminPassword": "password"
	},
	"SwaggerAuth": {
		"Username": "youruser",
		"Password": "yourpassword",
		"RequireLogin": true
	},
	"MediaFormat": {
		"VideoPreset": "h254_1440p_2pass_20M",
		"VideoThumbnailPreset": "first_frame",
		"ImagePreset": "webp",
		"MiniaturePreset": "webp",
		"MiniatureSize": 16
	},
	"MediaPresets": {
		"Video": {
			"h254_1440p_2pass_20M": [
				"-i \"{input}\" -vf \"scale='if(gt(iw,ih),-2,1440)':'if(gt(iw,ih),1440,-2)'\" -c:v libx264 -preset slow -aq-mode 3 -profile:v high -level 5.1 -b:v 20M -pass 1 -an -f null -",
				"-i \"{input}\" -vf \"scale='if(gt(iw,ih),-2,1440)':'if(gt(iw,ih),1440,-2)'\" -c:v libx264 -preset slow -aq-mode 3 -profile:v high -level 5.1 -b:v 20M -pass 2 -c:a copy -movflags +faststart \"{output}\""
			],
			"h254_1080p_2pass_10M": [
				"-i \"{input}\" -vf \"scale='if(gt(iw,ih),-2,1080)':'if(gt(iw,ih),1080,-2)'\" -c:v libx264 -preset slow -aq-mode 3 -profile:v high -level 5.1 -b:v 10M -pass 1 -an -f null -",
				"-i \"{input}\" -vf \"scale='if(gt(iw,ih),-2,1080)':'if(gt(iw,ih),1080,-2)'\" -c:v libx264 -preset slow -aq-mode 3 -profile:v high -level 5.1 -b:v 10M -pass 2 -c:a copy -movflags +faststart \"{output}\""
			],
			"h254_720p_2pass_5M": [
				"-i \"{input}\" -vf \"scale='if(gt(iw,ih),-2,720)':'if(gt(iw,ih),720,-2)'\" -c:v libx264 -preset slow -aq-mode 3 -profile:v high -level 5.1 -b:v 5M -pass 1 -an -f null -",
				"-i \"{input}\" -vf \"scale='if(gt(iw,ih),-2,720)':'if(gt(iw,ih),720,-2)'\" -c:v libx264 -preset slow -aq-mode 3 -profile:v high -level 5.1 -b:v 5M -pass 2 -c:a copy -movflags +faststart \"{output}\""
			]
		},
		"Image": {
			"webp": "-i \"{input}\" {videoThumbnailPrefix} -c:v libwebp -quality 88 -compression_level 6 -preset picture \"{output}\"",
			"avif": "-i \"{input}\" {videoThumbnailPrefix} -c:v libaom-av1 -still-picture 1 -crf 20 \"{output}\""
		},
		"VideoThumbnailPrefix": {
			"first_frame": "-ss 00:00:01 -frames:v 1",
			"auto": "-vf \"thumbnail\""
		},
		"Miniature": {
			"webp": "-i \"{input}\" -vf \"scale={miniatureSize}:{miniatureSize}:force_original_aspect_ratio=increase,crop={miniatureSize}:{miniatureSize}\" -c:v libwebp -quality 75 -compression_level 6 -preset picture -f webp pipe:1"
		}
	},
	"MediaStorage": {
		"Provider": "Local"
	},
	"MediaPreview": {
		"Provider": "Nextcloud",
		"VideoStorageBase": "https://yoursite.com/public.php/dav/files/yourfolderid/{fileName}",
		"Imgproxy": {
			"Endpoint": "https://yoursite.com",
			"FilePath": "",
			"Key": "",
			"Salt": "",
			"Insecure": true
		},
		"Nextcloud": {
			"PublicPreviewBase": "https://yoursite.com/apps/files_sharing/publicpreview/yourfolderid?file={fileName}&x={xAxis}&y={yAxis}&a=1"
		}
	},
	"MediaSizes": {
		"SizeBuckets": [ 256, 1024, 4096 ],
		"PreviewTargetCss": 200,
		"DefaultScreenResolution": 768
	},
	"LocalStorageProvider": {
		"Path": "D:\\Media"
	},
	"WebDavStorageProvider": {
		"Endpoint": "https://yoursite.com/remote.php/dav/files/youruser/files/yourfolder/",
		"Username": "youruser",
		"Password": "yourpassword"
	},
	"AiApi": {
		"ApiKey": "XXX",
		"Model": "deepseek-v4-flash",
		"Temperature": 0.3,
		"ApiUrl": "https://api.deepseek.com"
	},
	"Seq": {
		"Enabled": true,
		"ServerUrl": "http://localhost:5341",
		"ApiKey": "",
		"MinimumLevel": "Information"
	},
	"ConsoleLog": {
		"Enabled": true,
		"MinimumLevel": "Information"
	},
	"DebugLog": {
		"Enabled": false,
		"MinimumLevel": "Debug"
	},
	"FileLog": {
		"Enabled": true,
		"MinimumLevel": "Information",
		"RetainedDaysCountLimit": 30
	}
}
